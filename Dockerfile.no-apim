# Stage 1: Build the MkDocs static site with every API Manager version
# excluded. en/mkdocs.yml's nav lists every APIM version still present in
# this branch; strip-apim-nav.py collapses that whole section down to a
# single external-link stub before `mkdocs build` runs, and
# Dockerfile.no-apim.dockerignore keeps api-manager/ out of the build
# context so none of it reaches this image.
#
# This is a fast, lean stand-in for what this branch becomes once every
# APIM version has been split into its own branch (see apim-<version>) - a
# temporary alternative to the (currently much larger, slower) plain
# Dockerfile, useful for deploying and testing this branch's non-APIM
# content before that migration is complete.
FROM python:3.12 AS builder

WORKDIR /app

COPY en/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "setuptools<80"

COPY en/ .
COPY strip-apim-nav.py .
RUN python3 strip-apim-nav.py mkdocs.yml

RUN mkdocs build

# Stage 2: Serve with Nginx
FROM nginx:1.26-alpine

COPY --from=builder --chown=10014:nginx /app/site /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN apk upgrade --no-cache libcrypto3 libssl3

RUN adduser -u 10014 -D -H -G nginx appuser \
    && chown -R 10014:nginx /var/log/nginx \
    && chown -R 10014:nginx /var/cache/nginx \
    && chown -R 10014:nginx /etc/nginx/conf.d \
    && sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|g' /etc/nginx/nginx.conf

USER 10014

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
