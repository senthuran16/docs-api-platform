# Stage 1: Build the MkDocs static site for AI Gateway 1.1.0 only.
# en/mkdocs.yml's nav lists every AI Gateway version; trim-mkdocs-version.py
# strips it down to just this one before `mkdocs build` runs, and
# Dockerfile.1.1.0.dockerignore keeps every other version's docs out of the
# build context so they never reach this image.
FROM python:3.12 AS builder

WORKDIR /app

# The real hooks.py logic - see the docs-shared branch. Referenced here as a
# named build context (--build-context docs-shared=<path>) rather than a real
# git+https URL, since docs-shared isn't pushed anywhere yet; requirements.txt
# expects it at exactly this path.
COPY --from=docs-shared . /tmp/docs-shared-pkg

COPY en/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "setuptools<80"

COPY en/ .
COPY trim-mkdocs-version.py .
RUN python3 trim-mkdocs-version.py mkdocs.yml 1.1.0

RUN mkdocs build

# Stage 2: Serve with Nginx
FROM nginx:1.26-alpine

COPY --from=builder --chown=10014:nginx /app/site /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN apk upgrade --no-cache libcrypto3 libssl3

RUN adduser -u 10014 -D -H -G nginx appuser \
    && chown -R 10014:nginx /var/log/nginx \
    && chown -R 10014:nginx /var/cache/nginx \
    && chown -R 10014:nginx /etc/nginx/conf.d \
    && sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|g' /etc/nginx/nginx.conf

USER 10014

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
